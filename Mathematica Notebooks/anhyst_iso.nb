   RowBox[{"(*", 
    RowBox[{
    "Quick", " ", "check", " ", "at", " ", "the", " ", "point", " ", "you", " ",
      "already", " ", "validated"}], "*)"}], "\n", 
   RowBox[{"PrintMagField", "[", 
    RowBox[{
     RowBox[{"fMan", "[", 
      RowBox[{"Quantity", "[", 
