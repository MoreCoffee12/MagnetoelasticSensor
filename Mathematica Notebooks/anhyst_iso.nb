Cell["Anhysteretic  Taylor Series Expansion", "Subsubsection",
 CellChangeTimes->{{3.982486844042534*^9, 
  3.9824868535348873`*^9}},ExpressionUUID->"49bead2f-96a2-3645-af34-\
4bc73a499773"],

Cell[TextData[{
 "Neither the expression for anhysteretic curve or its deriviative behave \
well around zero. The  most robust way to work around this is to use  a few \
terms from the Tayler series  expansion when the effective magnetic field, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "eff"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "920a154b-461f-314a-9f3b-d7afb6ef73a4"],
 ", is small."
}], "Text",
 CellChangeTimes->{{3.9824868598981915`*^9, 
  3.9824869461397*^9}},ExpressionUUID->"0d646d0f-67a4-334f-a21c-03b749a32121"],

