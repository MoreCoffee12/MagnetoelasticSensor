Cell[TextData[{
 "a \t\tAnhysteretic magnetization shape parameter, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "/", "m"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36398a90-2639-364c-bf14-9245f8f103d9"],
 "\nH \t\tInternal magnetic field, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "/", "m"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8037f6d7-a443-b745-9873-023f7312493b"],
 "\nM \t\tBulk magnetization, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "/", "m"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7eb5dda9-ff42-444e-960c-18188b5f27b2"],
 "\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "s"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc6934ca-57b5-bb48-909e-b47a26dc1a00"],
 "\t\tSaturation magnetization,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "/", "m"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58f67e47-ea67-ad47-b84c-0a4cbb27a188"],
 "\n\[Alpha] \t\tmean field parameter, -\n\[Theta] \t\tAngle between stress \
and magnetic field, radians\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "o"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ae01300f-0ab7-a040-8583-629c6111e11b"],
 " \t\tPermeability of a vacuum, H/m\n\[Nu] \t\tPoisson\[CloseCurlyQuote]s \
ratio, -\n\[Sigma] \t\tStress, Pa\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2a36796-98b4-fd47-ade1-d3790c1a624f"],
 " \t\tApplied stress, Pa\n"
}], "Text",
 CellChangeTimes->{{3.982234960776346*^9, 3.982235016477154*^9}, {
