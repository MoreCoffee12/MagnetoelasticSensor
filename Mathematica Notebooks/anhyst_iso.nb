Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Build", " ", "the", " ", "anhysteretic", " ", "expression", " ", "from", " ",
     "your", " ", "symbolic", " ", "equation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"exprMan", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"eqnAnHysMagneto", "/.", " ", "subFig3"}], ")"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "anhysteretic", " ", "magnetization", " ", 
     "ratio", " ", 
     RowBox[{"M_an", "/", "M_s"}], " ", "as", " ", "a", " ", "function", " ", 
     "of", " ", "H"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fManOverMs", "[", "H_", "]"}], ":=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"exprMan", "/", "dMsInput"}], ")"}], "/.", " ", 
         RowBox[{"H", "->", "H"}]}], ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
