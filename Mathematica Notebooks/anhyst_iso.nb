Cell[BoxData[{
 RowBox[{
  RowBox[{"eqnStressMagField", " ", "=", " ", 
   RowBox[{"\[Sigma]", " ", "==", " ", 
    RowBox[{"\[Sigma]0", "*", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "-", 
       RowBox[{"\[Nu]", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HoldForm", "[", 
   RowBox[{"Evaluate", "[", "eqnStressMagField", "]"}], "]"}], "/.", 
  "subFmtPub"}]}], "Input",
