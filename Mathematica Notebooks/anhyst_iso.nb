     "ratio", " ", 
     RowBox[{"M_an", "/", "M_s"}], " ", "as", " ", "a", " ", "function", " ", 
     "of", " ", "H"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fManOverMs", "[", "H_", "]"}], ":=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{
